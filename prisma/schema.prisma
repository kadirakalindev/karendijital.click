generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== İŞLETME ====================

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // subdomain: xberber.karendijital.click
  description String?
  logo        String?
  coverImage  String?
  phone       String?
  email       String?
  address     String?
  city        String?
  district    String?
  latitude    Float?
  longitude   Float?
  website     String?
  instagram   String?
  currency    String   @default("TRY")
  timezone    String   @default("Europe/Istanbul")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workingHours    BusinessWorkingHour[]
  holidays        BusinessHoliday[]
  gallery         BusinessGallery[]
  members         BusinessMember[]
  customers       Customer[]
  serviceCategories ServiceCategory[]
  services        Service[]
  products        Product[]
  packages        Package[]
  appointments    Appointment[]
  timeBlocks      TimeBlock[]
  invoices        Invoice[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  notificationSettings NotificationSetting[]
  notificationLogs NotificationLog[]
  subscription    Subscription?
  auditLogs       AuditLog[]

  @@map("businesses")
}

model BusinessWorkingHour {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int     // 0=Pazar, 1=Pazartesi ... 6=Cumartesi
  isOpen     Boolean @default(true)
  openTime   String  // "09:00"
  closeTime  String  // "19:00"
  breakStart String? // "13:00"
  breakEnd   String? // "14:00"

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_working_hours")
}

model BusinessHoliday {
  id         String   @id @default(cuid())
  businessId String
  name       String
  date       DateTime
  isRecurring Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_holidays")
}

model BusinessGallery {
  id         String   @id @default(cuid())
  businessId String
  imageUrl   String
  title      String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_gallery")
}

// ==================== KULLANICI ====================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String
  phone         String?
  image         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships BusinessMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model BusinessMember {
  id         String         @id @default(cuid())
  businessId String
  userId     String
  role       BusinessRole   @default(STAFF)
  title      String?        // "Kuaför", "Güzellik Uzmanı"
  color      String?        // Takvimde renk kodu
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours  StaffWorkingHour[]
  timeOffs      StaffTimeOff[]
  staffServices StaffService[]
  appointments  Appointment[]
  timeBlocks    TimeBlock[]

  @@unique([businessId, userId])
  @@map("business_members")
}

enum BusinessRole {
  OWNER
  MANAGER
  STAFF
}

model StaffWorkingHour {
  id       String  @id @default(cuid())
  memberId String
  dayOfWeek Int    // 0=Pazar ... 6=Cumartesi
  isOpen    Boolean @default(true)
  openTime  String  // "09:00"
  closeTime String  // "19:00"
  breakStart String?
  breakEnd   String?

  member BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dayOfWeek])
  @@map("staff_working_hours")
}

model StaffTimeOff {
  id        String   @id @default(cuid())
  memberId  String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  member BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("staff_time_off")
}

// ==================== MÜŞTERİ ====================

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  email      String?
  gender     Gender?
  birthDate  DateTime?
  notes      String?
  balance    Float    @default(0) // Pozitif: alacak, Negatif: borç
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  invoices         Invoice[]
  customerPackages CustomerPackage[]

  @@unique([businessId, phone])
  @@map("customers")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ==================== HİZMET / ÜRÜN ====================

model ServiceCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([businessId, name])
  @@map("service_categories")
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  categoryId  String?
  name        String
  description String?
  duration    Int      // dakika cinsinden
  price       Float
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ServiceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffServices       StaffService[]
  appointmentServices AppointmentService[]
  packageServices     PackageService[]

  @@map("services")
}

model StaffService {
  id        String @id @default(cuid())
  memberId  String
  serviceId String
  price     Float? // Personele özel fiyat (null ise servis fiyatı)
  duration  Int?   // Personele özel süre

  member  BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([memberId, serviceId])
  @@map("staff_services")
}

model Product {
  id         String   @id @default(cuid())
  businessId String
  name       String
  description String?
  price      Float
  stock      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business            Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointmentProducts AppointmentProduct[]

  @@map("products")
}

// ==================== PAKET ====================

model Package {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageServices  PackageService[]
  customerPackages CustomerPackage[]

  @@map("packages")
}

model PackageService {
  id        String @id @default(cuid())
  packageId String
  serviceId String
  quantity  Int    @default(1) // Bu servisten kaç seans

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@map("package_services")
}

model CustomerPackage {
  id          String   @id @default(cuid())
  customerId  String
  packageId   String
  purchaseDate DateTime @default(now())
  expiryDate  DateTime?
  isActive    Boolean  @default(true)

  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package  Package               @relation(fields: [packageId], references: [id], onDelete: Cascade)
  usages   CustomerPackageUsage[]

  @@map("customer_packages")
}

model CustomerPackageUsage {
  id                String   @id @default(cuid())
  customerPackageId String
  appointmentId     String?
  serviceId         String
  usedAt            DateTime @default(now())

  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)

  @@map("customer_package_usages")
}

// ==================== RANDEVU ====================

model Appointment {
  id          String            @id @default(cuid())
  businessId  String
  customerId  String?
  memberId    String            // Personel
  startTime   DateTime
  endTime     DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  customerName String?          // Kayıtsız müşteri için
  customerPhone String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  member   BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  services AppointmentService[]
  products AppointmentProduct[]
  invoice  Invoice?

  @@index([businessId, startTime])
  @@index([memberId, startTime])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String
  price         Float
  duration      Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("appointment_services")
}

model AppointmentProduct {
  id            String @id @default(cuid())
  appointmentId String
  productId     String
  quantity      Int    @default(1)
  price         Float

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("appointment_products")
}

model TimeBlock {
  id         String   @id @default(cuid())
  businessId String
  memberId   String?
  title      String
  startTime  DateTime
  endTime    DateTime
  isRecurring Boolean @default(false)
  recurrenceRule String? // iCal RRULE
  createdAt  DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member   BusinessMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("time_blocks")
}

// ==================== ÖDEME ====================

model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  customerId    String?
  appointmentId String?       @unique
  invoiceNo     String
  subtotal      Float
  discount      Float         @default(0)
  total         Float
  status        InvoiceStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Float
  method    PaymentMethod
  note      String?
  paidAt    DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  OTHER
}

// ==================== MASRAF ====================

model ExpenseCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([businessId, name])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(cuid())
  businessId  String
  categoryId  String?
  description String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

// ==================== BİLDİRİM ====================

model NotificationSetting {
  id         String           @id @default(cuid())
  businessId String
  type       NotificationType
  isEnabled  Boolean          @default(true)
  template   String?
  sendBefore Int?             // dakika (randevu hatırlatması)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
  @@map("notification_settings")
}

enum NotificationType {
  APPOINTMENT_REMINDER
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_CANCELLATION
  BIRTHDAY_GREETING
}

model NotificationLog {
  id         String             @id @default(cuid())
  businessId String
  recipient  String             // telefon veya email
  channel    NotificationChannel
  content    String
  status     NotificationStatus @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ==================== ABONELİK ====================

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  monthlyPrice  Float
  yearlyPrice   Float?
  maxStaff      Int      @default(5)
  maxCustomers  Int      @default(500)
  features      String[] // ["sms", "whatsapp", "reports"]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id         String             @id @default(cuid())
  businessId String             @unique
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ==================== AUDIT ====================

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  action     String   // "CREATE", "UPDATE", "DELETE"
  entity     String   // "appointment", "customer", etc.
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("audit_logs")
}
